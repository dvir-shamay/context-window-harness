# Context Window Experiment Harness — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NEVER be committed.

# ─── Azure AI Foundry / MaaS (DeepSeek, Phi-4, Llama, Grok, etc.) ───
AZURE_AI_KEY=
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com

# ─── Azure OpenAI (GPT-4o, GPT-5.x) ───
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ─── GitHub Models (Claude, Gemini, etc. via GitHub marketplace) ───
# Create a fine-grained PAT with Models: Read-only scope
GITHUB_TOKEN=

# ─── Local Bridge (optional — any OpenAI-compatible local proxy) ───
# LOCAL_BRIDGE_PORT=3456

# ─── Data paths (optional — defaults to ./data/ relative to harness root) ───
# DATA_DIR=./data
# MEETINGS_CSV=./data/meetings.csv
# EMAILS_CSV=./data/emails.csv
# CHAT_SCORES_CSV=./data/chat_scores.csv
# CHAT_DIR=./data/chats
